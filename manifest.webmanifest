  "icons": [
    { "src": "icons/elog-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "icons/elog-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/elog-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}

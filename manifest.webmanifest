{
  "id": "./",
  "name": "eLOG Trading Journal",
  "short_name": "eLOG",
  "description": "A privacy-conscious local or cloud trading journal for stocks, options, futures, and forex.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
